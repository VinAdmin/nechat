{
    "name": "vinadmin/nechat",
    "description": "Chat, a website based on the WCO core. Still under development.",
    "type": "project",
    "authors": [
        {
            "name": "Vitaliy Olkhin",
            "email": "ovvitalik@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
    ],
    "require": {
        "vinadmin/wco": "^v1.0",
        "tracy/tracy": "v2.11.3",
        "robmorgan/phinx": "0.12.11",
        "firebase/php-jwt": "v7.0.5",
        "ramsey/uuid": "5.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4@dev"
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test:unit": "phpunit --testdox --testsuite Unit",
        "test:functional": "phpunit --testdox --testsuite Functional"
    }
}
